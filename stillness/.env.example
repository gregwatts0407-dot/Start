# --- Required -----------------------------------------------------------------
# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the Stripe webhook, the reminder job and the admin user list.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app, used in auth emails and Stripe redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: premium subscriptions (Stripe) ----------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Optional: reminder emails ---------------------------------------------------
# Resend API key and sender. Without them the reminder job logs instead of sending.
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Stillness <reminders@example.com>"
# Shared secret for the /api/cron/reminders endpoint (Vercel Cron sends it automatically).
CRON_SECRET=
